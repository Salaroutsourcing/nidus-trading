# Database
# Production (Vercel): Neon Postgres connection string (use pooled URL when available)
# Local Postgres: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local SQLite fallback: set provider = "sqlite" in prisma/schema.prisma and use:
# DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth / Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_NAME="Nidus Trading"
NEXT_PUBLIC_COMPANY_PHONE="0349-0307920"
NEXT_PUBLIC_COMPANY_TAGLINE="Premium Industrial & Electronic Solutions – Quality, Reliability, Competitive Pricing"

# Optional image CDN
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seeded admin account
ADMIN_EMAIL="admin@nidustrading.com"
ADMIN_PASSWORD="change-me-strong-password"
